{
  // sets layout for biome key item grid
  "biome_keys": {
    "type": "group",
    "header": "Biome Keys",
    "content": [
      {
        "type": "itemgrid",
        "dock": "bottom",
        "h_alignment": "left",
        "item_margin": "5,5",
        "item_size": "60,60",
        "rows": [
          ["key_royal_woodlands", "key_coral_forest", "key_marshlands", "key_scarlet_orchard", "key_cursed_royal_woodlands"],
          ["key_coastal_grove", "key_ashen_thicket", "key_bamboo_flats", "key_rocky_ravine", "key_sealed_forest"]
        ]
      }
    ]
  }
}